---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout title="Contact" description={`Hours, phone and directions for Jimmy's of Watertown, ${site.address.street}, ${site.address.city}, ${site.address.state}.`}>
  <div class="pt-8 text-center">
    <h1 class="text-4xl font-bold">Have a Question?</h1>
    <h2 class="mt-2 pb-4 text-2xl">Contact Us!</h2>
  </div>

  <div class="mx-5 flex flex-col gap-10 pb-10 lg:flex-row lg:justify-between">
    <section class="text-center lg:w-[45%]">
      <h3 class="mb-3 text-3xl font-bold">Hours of Operation</h3>
      {site.hours.map((h) => (
        <p class="text-xl">{h.days === 'Mon–Sat' ? 'Monday - Saturday' : h.days}: {h.time}</p>
      ))}
      <p class="mt-3 text-xl">
        <a href={site.phoneHref} class="hover:text-accent hover:underline">{site.phone}</a>
      </p>
      <address class="mt-2 text-xl not-italic">
        {site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}
      </address>
      <div class="mt-4 flex justify-center gap-4">
        <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition-colors hover:text-accent">
          <Icon name="facebook" class="size-9" />
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition-colors hover:text-accent">
          <Icon name="instagram" class="size-9" />
        </a>
      </div>
    </section>

    <section class="text-center lg:w-[45%]">
      <h3 class="mb-3 text-3xl font-bold">Stop By</h3>
      <iframe
        src={site.mapEmbed}
        title="Map to Jimmy's of Watertown"
        class="h-[450px] w-full border-0 lg:h-[600px]"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </section>
  </div>
</Layout>
