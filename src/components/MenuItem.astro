---
import type { MenuItem } from '../data/menuData';

interface Props { item: MenuItem }
const { item } = Astro.props;
---

<div class="mb-3">
  <div class="flex items-end gap-1.5">
    <span class="font-semibold">{item.name}</span>
    {item.price && (
      <>
        <span class="mb-1 flex-1 border-b-2 border-dotted border-gray-800" aria-hidden="true"></span>
        <span class="shrink-0 whitespace-nowrap font-semibold">{item.price}</span>
      </>
    )}
  </div>
  {item.description && <p class="text-gray-600">{item.description}</p>}
  {item.additions?.map((a) => (
    <p class="mt-1 text-sm text-gray-600">
      <span class="font-bold">{a.name}</span>
      {a.price && <span class="ml-2.5 text-gray-800">{a.price}</span>}
    </p>
  ))}
</div>
