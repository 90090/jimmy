---
// Renders a full meal (Breakfast or Lunch). Replaces the duplicated JSX that lived in
// Menu.js, Breakfast.js and Lunch.js.
import MenuItem from './MenuItem.astro';
import type { MenuSection } from '../data/menuData';

interface Props {
  heading: string;
  sections: MenuSection[];
  id?: string;
}
const { heading, sections, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl scroll-mt-40 px-5 py-8">
  <h1 class="mb-8 text-center text-4xl font-bold">{heading}</h1>

  {sections.map((section) => (
    <section class="mb-10">
      {section.title && <h2 class="mb-1 text-center text-2xl font-bold">{section.title}</h2>}
      {section.description && <p class="pb-4 text-center text-gray-500">{section.description}</p>}

      {section.items && (
        <div class="mx-auto max-w-3xl px-2 md:px-5">
          {section.items.map((item) => <MenuItem item={item} />)}
        </div>
      )}

      {section.columns && (
        <div class="grid gap-x-12 gap-y-6 px-2 md:grid-cols-2 md:px-5">
          {section.columns.map((col) => (
            <div>
              {col.title && (
                <div class="mb-3">
                  <h2 class="text-center text-2xl font-bold">{col.title}</h2>
                  {col.subtitle && <p class="text-center text-gray-500">{col.subtitle}</p>}
                </div>
              )}
              {col.items.map((item) => <MenuItem item={item} />)}
            </div>
          ))}
        </div>
      )}
    </section>
  ))}
</section>
