---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/images/Jimmys.png';
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/menu' ? ['/menu', '/breakfast', '/lunch'].includes(path) : path === href;

const leftLinks = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu', children: [
    { href: '/breakfast', label: 'Breakfast' },
    { href: '/lunch', label: 'Lunch' },
  ] },
  { href: '/about', label: 'About' },
];
const rightLinks = [
  { href: '/contact', label: 'Contact' },
  { href: '/store', label: 'Store' },
  { href: site.giftCards, label: 'Gift Cards', external: true },
];
const allLinks = [...leftLinks, ...rightLinks];

const linkBase =
  'border-b-4 border-transparent px-2 py-2 text-lg font-bold transition-colors duration-200 hover:border-accent hover:text-accent xl:px-4 xl:text-xl';
const linkClass = (href: string) =>
  `${linkBase} ${isActive(href) ? 'text-brand hover:!border-brand hover:!text-brand' : 'text-black'}`;
---

<header class="sticky top-0 z-40 bg-white shadow-sm">
  <!--
    One row, three columns: [phone] [links · logo · links] [socials].
    The outer columns are 1fr each, so the logo stays centered on the page.
  -->
  <nav class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 py-2 lg:px-6" aria-label="Main">
    <!-- Left: phone -->
    <a
      href={site.phoneHref}
      class="flex items-center gap-2 justify-self-start font-bold text-black transition-colors hover:text-accent"
      aria-label={`Call us at ${site.phone}`}
    >
      <Icon name="phone" class="size-6 shrink-0" />
      <span class="hidden whitespace-nowrap text-lg sm:inline lg:hidden xl:inline xl:text-xl">{site.phone}</span>
    </a>

    <!-- Center: links + logo -->
    <div class="flex items-center justify-center gap-1 xl:gap-2">
      <ul class="hidden items-center lg:flex">
        {leftLinks.map((link) => (
          <li class={link.children ? 'group relative' : ''}>
            <a href={link.href} class={`${linkClass(link.href)} inline-flex items-center gap-1`}>
              {link.label}
              {link.children && <Icon name="chevron-down" class="size-4" />}
            </a>
            {link.children && (
              <ul class="invisible absolute left-0 top-full z-50 min-w-40 bg-white opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} class={`block border-b-4 border-transparent px-4 py-3 font-semibold transition-colors hover:border-accent hover:text-accent ${path === child.href ? 'text-brand' : 'text-black'}`}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <a href="/" class="shrink-0 px-2" aria-label={`${site.name} home`}>
        <Image src={logo} alt={site.name} class="h-16 w-auto lg:h-20 xl:h-24" loading="eager" />
      </a>

      <ul class="hidden items-center lg:flex">
        {rightLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`${linkClass(link.href)} whitespace-nowrap`}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right: socials (+ hamburger on mobile) -->
    <div class="flex items-center gap-3 justify-self-end text-black">
      <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition-colors hover:text-accent">
        <Icon name="facebook" class="size-7 xl:size-8" />
      </a>
      <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition-colors hover:text-accent">
        <Icon name="instagram" class="size-7 xl:size-8" />
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="-mr-2 rounded p-2 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span data-icon-open><Icon name="menu" class="size-8" /></span>
        <span data-icon-close class="hidden"><Icon name="close" class="size-8" /></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="pointer-events-none absolute inset-x-0 top-full h-[calc(100dvh-100%)] -translate-x-full overflow-y-auto bg-white opacity-0 transition-all duration-500 lg:hidden"
  >
    <ul class="flex flex-col text-center">
      {allLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`block py-5 text-2xl font-bold transition-colors hover:text-accent ${isActive(link.href) ? 'text-brand' : 'text-black'}`}
            {...('external' in link && link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
          {'children' in link && link.children && (
            <ul>
              {link.children.map((child) => (
                <li>
                  <a href={child.href} class={`block py-3 text-lg font-semibold transition-colors hover:text-accent ${path === child.href ? 'text-brand' : 'text-gray-600'}`}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li>
        <a href={site.phoneHref} class="block py-5 text-xl font-bold text-black hover:text-accent">
          Call {site.phone}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      panel.classList.toggle('-translate-x-full', !open);
      panel.classList.toggle('opacity-0', !open);
      panel.classList.toggle('pointer-events-none', !open);
      document.body.classList.toggle('overflow-hidden', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>